#--------------------------------------------------------------------
# Okina Craft — CodeIgniter 4 Environment Configuration
#--------------------------------------------------------------------

# Switch to 'production' when deploying to live shared hosting
CI_ENVIRONMENT = production

# Set your live domain (with trailing slash) when deploying
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Kolkata'

#--------------------------------------------------------------------
# DATABASE
# Default on local development: SQLite3 (zero setup needed!)
# For cPanel / Production: Use MySQL / MariaDB below
#--------------------------------------------------------------------
# To enable MySQL on cPanel, uncomment the lines below and fill your credentials:
# database.default.hostname = localhost
# database.default.database = cpaneluser_okinacraft
# database.default.username = cpaneluser_dbuser
# database.default.password = YourStrongPasswordHere
# database.default.DBDriver = MySQLi
# database.default.port = 3306

#--------------------------------------------------------------------
# DEFAULT ADMIN (Created on first seed — change in Admin -> Settings!)
#--------------------------------------------------------------------
store.defaultAdminEmail = 'admin@okinacraft.com'
store.defaultAdminPassword = 'OkinaCraft@2026!'
store.defaultAdminName = 'Okina Craft Admin'
