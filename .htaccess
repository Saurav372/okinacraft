Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|writable|vendor|tests|system)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|spark|README\.md|phpunit\.xml\.dist)$ - [F,L,NC]

    # Direct static asset requests into public folder so CSS/JS/images are served with correct MIME type
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(assets|uploads|favicon\.ico|favicon\.svg|robots\.txt)(.*)$ public/$1$2 [L,NC]

    # Route all other page requests through public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php/$1 [L,QSA]
</IfModule>
